generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  vendor
}

enum CompanyStatus {
  active
  inactive
}

enum NdaStatus {
  pending
  uploaded
  signed
  rejected
}

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  supabaseId         String          @unique
  name               String
  email              String          @unique
  designation        String?
  role               Role            @default(vendor)
  defaultCompany     Company?        @relation("DefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  defaultCompanyId   String?         @db.ObjectId
  lastUsedCompany    Company?        @relation("LastUsedCompany", fields: [lastUsedCompanyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lastUsedCompanyId  String?         @db.ObjectId
  companies          Company[]       @relation("VendorCompanies")
  referrals          Referral[]
  reports            Report[]
  contracts          Contract[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Company {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  logo        String?
  accentColor String?
  status      CompanyStatus   @default(active)
  ndaUrl      String?         
  ndaStatus   NdaStatus       @default(pending)
  vendorId    String?         @db.ObjectId
  vendor      User?           @relation("VendorCompanies", fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals   Referral[]
  reports     Report[]
  defaultFor  User[]          @relation("DefaultCompany")
  lastUsedFor User[]          @relation("LastUsedCompany")
  contracts   Contract[]
  ndaSentAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Referral {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String
  productInfo    String
  referenceLinks String[]
  hostName       String
  hostEmail      String
  vendor         User     @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendorId       String   @db.ObjectId
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companyId      String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
  @@index([companyId])
  @@index([vendorId, companyId])
}

enum ReportType {
  GENERAL
  NDA
}

model Report {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  type         ReportType @default(GENERAL)
  status       NdaStatus  @default(pending)
  fileUrl      String?
  filePublicId String?
  fileType     String?
  fileName     String?
  fileSize     Int?
  vendor       User     @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendorId     String   @db.ObjectId
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companyId    String   @db.ObjectId
  sentToEmail  String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@index([companyId])
  @@index([vendorId, companyId])
}

model Contract {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  projectName       String
  totalProjectValue Float
  status            ContractStatus @default(active)
  vendor            User           @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendorId          String         @db.ObjectId
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companyId         String         @db.ObjectId
  phases            Phase[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([vendorId])
  @@index([companyId])
  @@index([vendorId, companyId])
}

type Phase {
  name             String
  dueDate          DateTime
  commissionType   CommissionType
  commissionValue  Float
  calculatedAmount Float
  status           PhaseStatus    @default(pending)
}

enum ContractStatus {
  draft
  active
  completed
}

enum CommissionType {
  fixed
  percentage
}

enum PhaseStatus {
  pending
  paid
}
